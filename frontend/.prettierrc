{
	"singleQuote": true,
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 4,
	"semi": false,
	"bracketSpacing": true,
	"printWidth": 120,
	"endOfLine": "auto",
	"arrowParens": "avoid",
	"tailwindStylesheet": "./apps/web/src/styles.css",
	"tailwindFunctions": ["hlm", "cva", "classes"],
	"plugins": ["prettier-plugin-tailwindcss"]
}
