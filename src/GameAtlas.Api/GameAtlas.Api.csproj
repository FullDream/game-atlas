<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>c28d7c23-9ee1-4442-9302-3d66e17bfe8a</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../GameAtlas.Application/GameAtlas.Application.csproj" />
        <ProjectReference Include="../GameAtlas.Infrastructure/GameAtlas.Infrastructure.csproj" />
        <ProjectReference Include="..\GameAtlas.Domain\GameAtlas.Domain.csproj" />
    </ItemGroup>

</Project>
