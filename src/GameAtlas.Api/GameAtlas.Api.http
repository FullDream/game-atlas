@GameAtlas_Api_HostAddress = https://localhost:7241
@gameId = 019a0000-0000-7000-8000-000000000001
@mapId = 019a0000-0000-7000-8000-000000000004
@categoryGroupId = 019a0000-0000-7000-8000-000000000002
@iconAssetId = 019a0000-0000-7000-8000-000000000111
@imageAssetId = 019a0000-0000-7000-8000-000000000112
@videoAssetId = 019a0000-0000-7000-8000-000000000113

# Default page: offset=0, limit=20, no explicit order.
GET {{GameAtlas_Api_HostAddress}}/games
Accept: application/json

###

# Search a literal substring; Total counts all matches before pagination.
GET {{GameAtlas_Api_HostAddress}}/games?offset=0&limit=20&search=ring
Accept: application/json

###

GET {{GameAtlas_Api_HostAddress}}/games?offset=0&limit=20&sortBy=createdAt&sortDirection=desc
Accept: application/json

###

GET {{GameAtlas_Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Apply migrations first, then run the API with --launch-profile https.
# Repeating this request returns 409 because the slug is unique.
POST {{GameAtlas_Api_HostAddress}}/games
Content-Type: application/json
Accept: application/json

{
  "name": "Elden Ring",
  "slug": "elden-ring",
  "coverId": "{{imageAssetId}}"
}

###

# Replace gameId with the id returned by creation. Omitted fields retain their values.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}
Content-Type: application/merge-patch+json
Accept: application/json

{
  "name": "Elden Ring Updated",
  "coverId": "{{imageAssetId}}"
}

###

# application/json uses the same merge-patch semantics.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}
Content-Type: application/json
Accept: application/json

{
  "status": "published"
}

###

PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}
Content-Type: application/merge-patch+json
Accept: application/json

{
  "status": "draft"
}

###

# mapId is not part of GameDto: this PATCH returns 400. Manage maps through /games/{gameId}/maps/{mapId}.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}
Content-Type: application/json
Accept: application/json

{
  "mapId": null
}

###

# Permanently delete a draft or published game. Success: 204 with no body; repeating: 404.
# The slug becomes available for creation or updating another game.
# Its category groups are also permanently deleted.
DELETE {{GameAtlas_Api_HostAddress}}/games/{{gameId}}

###

# Replace gameId with an existing game's id. A new group is appended to its list.
POST {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups
Content-Type: application/json

{
  "name": "Resources"
}

###

# All groups in display order, without pagination.
GET {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups

###

# Replace categoryGroupId with an id returned by creation or listing.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}
Content-Type: application/merge-patch+json

{
  "name": "Collectibles",
  "order": 10
}

###

# Physical deletion: 204; repeat deletion: 404. Survivor positions are preserved.
DELETE {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}

###

# Use a committed image ID from POST /media/assets as iconAssetId. Default order appends within this group.
POST {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}/categories
Content-Type: application/json

{
  "name": "Chests",
  "iconAssetId": "{{iconAssetId}}",
  "color": "#ff8800"
}

###

# Full ordered array with current marker counts.
GET {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}/categories

###

# Replace categoryId with a returned category ID. Only supplied fields change.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}/categories/{{categoryId}}
Content-Type: application/merge-patch+json

{
  "name": "Rare chests",
  "order": 10,
  "color": "#ABCDEF"
}

###

# Transfer to another group of the same game. Preserve order unless explicitly supplied.
# After success, use destinationCategoryGroupId in subsequent category routes.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}/categories/{{categoryId}}
Content-Type: application/json

{
  "categoryGroupId": "{{destinationCategoryGroupId}}"
}

###

# Physical category deletion: 204, then 404 on repeat. No survivor renumbering.
DELETE {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/category-groups/{{categoryGroupId}}/categories/{{categoryId}}

###

# Complete marker list, including ordered media. No pagination or category filters.
GET {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers

###

# Creation returns 200. Replace categoryId with a category belonging to gameId.
POST {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "name": "Chest",
  "description": "Behind the waterfall",
  "position": { "x": -120.5, "y": 200 },
  "media": ["{{imageAssetId}}", "{{videoAssetId}}"]
}

###

# Recursive object merge: update only x, preserving y and omitted media.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers/{{markerId}}
Content-Type: application/merge-patch+json; charset=utf-8

{
  "position": { "x": 200 }
}

###

# Complete media ID replacement. Alt and preview are shared metadata edited through the library.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers/{{markerId}}
Content-Type: application/json

{
  "media": ["{{imageAssetId}}", "{{videoAssetId}}"]
}

###

# Transfer within the same game, clear description, and remove all media.
PATCH {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers/{{markerId}}
Content-Type: application/merge-patch+json

{
  "categoryId": "{{destinationCategoryId}}",
  "description": null,
  "media": []
}

###

# Physical deletion: empty 204, then 404 on repeat. Deletes media rows, never referenced files.
# Deleting the current category, group, or game also cascades through marker/media rows.
DELETE {{GameAtlas_Api_HostAddress}}/games/{{gameId}}/maps/{{mapId}}/markers/{{markerId}}

###
